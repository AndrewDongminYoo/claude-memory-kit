{
  "name": "claude-memory-kit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "On-demand skills for managing Claude Code native memory",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test \"scripts/**/*.test.ts\"",
    "verify:plugin": "node dist/verify-plugin.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
